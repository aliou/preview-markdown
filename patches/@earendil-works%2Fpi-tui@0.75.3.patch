+    renderCodeBlock(code, lang, availableWidth) {
+        const lines = [];
+        const borderStyle = this.theme.codeBlockBorder;
+        let codeLines;
+        if (this.theme.highlightCode) {
+            codeLines = this.theme.highlightCode(code, lang);
+        }
+        else {
+            codeLines = code.split("\n").map((line) => this.theme.codeBlock(line));
+        }
+        let maxLineWidth = 0;
+        for (const line of codeLines) {
+            const lineWidth = visibleWidth(line);
+            if (lineWidth > maxLineWidth) {
+                maxLineWidth = lineWidth;
+            }
+        }
+        const maxInnerWidth = Math.max(2, availableWidth - 2);
+        const maxLabelWidth = Math.max(0, maxInnerWidth - 4);
+        const rawLangLabel = lang || "";
+        const langLabel = rawLangLabel.length > maxLabelWidth ? rawLangLabel.slice(0, maxLabelWidth) : rawLangLabel;
+        const minWidthForLabel = langLabel ? visibleWidth(langLabel) + 4 : 2;
+        const innerWidth = Math.min(maxInnerWidth, Math.max(maxLineWidth + 2, minWidthForLabel, 2));
+        const codeContentWidth = Math.max(1, innerWidth - 2);
