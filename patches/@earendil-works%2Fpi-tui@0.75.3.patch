+                const wrappedCodeLine = i === 0 ? wrappedCodeLines[i] : continuationIndent + wrappedCodeLines[i];
+                const lineWidth = visibleWidth(wrappedCodeLine);
+                const padding = " ".repeat(Math.max(0, codeContentWidth - lineWidth));
+                const line = borderStyle(BOX_CHARS.vertical) + " " + wrappedCodeLine + padding + " " + borderStyle(BOX_CHARS.vertical);
+                lines.push(line);
+            }
+        }
+        const bottomBorder = BOX_CHARS.bottomLeft + BOX_CHARS.horizontal.repeat(innerWidth) + BOX_CHARS.bottomRight;
