{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/aliou/preview-markdown/main/schema.json",
  "title": "pmd configuration",
  "type": "object",
  "properties": {
    "$schema": {
      "description": "JSON Schema URL for editor validation",
      "type": "string",
      "format": "uri"
    },
    "showLineNumbers": {
      "default": false,
      "description": "Show line numbers in the pager",
      "type": "boolean"
    },
    "theme": {
      "default": {
        "dark": "senzu-dark",
        "light": "senzu-light"
      },
      "description": "A bundled theme name, or the name of a TextMate theme file in the themes directory next to the global config",
      "anyOf": [
        {
          "type": "string",
          "description": "Theme name to use for both light and dark mode"
        },
        {
          "type": "object",
          "properties": {
            "dark": {
              "type": "string",
              "description": "Theme name for dark mode"
            },
            "light": {
              "type": "string",
              "description": "Theme name for light mode"
            }
          },
          "required": ["dark", "light"],
          "additionalProperties": false,
          "description": "Separate themes for dark and light mode"
        }
      ]
    }
  },
  "additionalProperties": false,
  "description": "Configuration file for pmd (preview-markdown)"
}
