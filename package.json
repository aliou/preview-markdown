{
  "name": "preview-markdown",
  "version": "0.13.1",
  "description": "Terminal markdown pager with syntax highlighting",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "bin": {
    "pmd": "src/index.ts"
  },
  "scripts": {
    "start": "bun run src/index.ts",
    "lint": "biome check",
    "format": "biome check --write",
    "typecheck": "tsc --noEmit",
    "build": "bun run scripts/build.ts",
    "changeset": "changeset",
    "version": "bun run scripts/version.ts"
  },
  "devDependencies": {
    "@aliou/biome-plugins": "^0.18.1",
    "@biomejs/biome": "^2.6.7",
    "@changesets/cli": "^3.0.3",
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@earendil-works/pi-tui": "^1.5.2",
    "chalk": "^6.0.1",
    "lovely-mermaid": "^0.3.3",
    "shiki": "^4.6.0"
  }
}
