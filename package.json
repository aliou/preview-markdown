{
  "name": "preview-markdown",
  "version": "0.13.0",
  "description": "Terminal markdown pager with syntax highlighting",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "bin": {
    "pmd": "src/index.ts"
  },
  "scripts": {
    "start": "bun run src/index.ts",
    "lint": "biome check",
    "format": "biome check --write",
    "typecheck": "tsc --noEmit",
    "build": "bun run scripts/build.ts",
    "changeset": "changeset",
    "version": "bun run scripts/version.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@changesets/cli": "^2.29.8",
    "@types/bun": "latest",
    "@types/node": "^22.0.0"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@earendil-works/pi-tui": "0.84.0",
    "chalk": "^5.6.2",
    "grok-mermaid": "^0.2.2",
    "shiki": "^3.20.0"
  },
  "patchedDependencies": {
    "@earendil-works/pi-tui@0.84.0": "patches/@earendil-works%2Fpi-tui@0.84.0.patch"
  }
}
