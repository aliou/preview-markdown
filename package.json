{
  "name": "preview-markdown",
  "version": "0.14.0",
  "description": "Terminal markdown pager with syntax highlighting",
  "type": "module",
  "private": true,
  "bin": {
    "pmd": "dist/index.mjs"
  },
  "scripts": {
    "start": "tsx src/index.ts",
    "lint": "biome check",
    "format": "biome check --write",
    "typecheck": "tsc --noEmit",
    "build": "tsdown",
    "changeset": "changeset",
    "version": "tsx scripts/version.ts",
    "schema": "tsx scripts/schema.ts && biome format --write schema.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "@aliou/biome-plugins": "^0.18.1",
    "@biomejs/biome": "^2.6.7",
    "@changesets/cli": "^3.0.3",
    "@types/node": "^26.6.6",
    "tsdown": "^0.23.7",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@earendil-works/pi-tui": "^1.5.2",
    "chalk": "^6.0.1",
    "lovely-mermaid": "^0.3.3",
    "shiki": "^4.6.0",
    "zod": "^4.6.7"
  },
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@12.18.0"
}
